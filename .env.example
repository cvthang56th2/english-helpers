# Neon Postgres (use pooled connection string from Neon Console)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth — Project → Branch → Auth → Enable Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-32-plus-char-secret
